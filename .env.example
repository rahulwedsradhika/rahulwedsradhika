# ==============================================================================
# RAHUL WEDS RADHIKA: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in your production hosting platform.
# NOTE: Only variables prefixed with VITE_ are accessible to browser client code.
# NEVER place private credentials or Supabase service_role keys in this file.
# ==============================================================================

# Supabase Cloud Database & Storage (Public Anonymous Client Key only)
# Obtain from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Google Maps Platform API Key (if embedding custom Google Maps directions)
VITE_GOOGLE_MAPS_KEY=""

