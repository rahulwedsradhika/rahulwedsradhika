# PHASE 6: SUPABASE BACKEND + RSVP

First run the SQL below in the Supabase SQL editor. It creates the tables with Row Level Security (RLS), which is what keeps a public anon key safe.

### 6.0 SQL: run this yourself in Supabase

```sql
-- ============ TABLES ============
create table if not exists public.rsvps (
  id uuid primary key default gen_random_uuid(),
  created_at timestamptz not null default now(),
  full_name text not null check (char_length(full_name) between 2 and 80),
  phone text check (phone is null or char_length(phone) between 7 and 20),
  attending text not null check (attending in ('yes','no','maybe')),
  guest_count int not null default 1 check (guest_count between 1 and 15),
  events text[] not null default '{}',
  side text check (side in ('groom','bride','both')),
  diet text check (diet in ('veg','non-veg','jain','none')),
  needs_stay boolean not null default false,
  needs_pickup boolean not null default false,
  arrival_info text check (arrival_info is null or char_length(arrival_info) <= 200),
  message text check (message is null or char_length(message) <= 300),
  lang text check (lang in ('en','hi'))
);

create table if not exists public.wishes (
  id uuid primary key default gen_random_uuid(),
  created_at timestamptz not null default now(),
  name text not null check (char_length(name) between 2 and 60),
  message text not null check (char_length(message) between 2 and 400),
  approved boolean not null default false
);

create table if not exists public.song_requests (
  id uuid primary key default gen_random_uuid(),
  created_at timestamptz not null default now(),
  name text not null check (char_length(name) between 2 and 60),
  song text not null check (char_length(song) between 2 and 120),
  artist text check (artist is null or char_length(artist) <= 80)
);

create table if not exists public.contacts (
  id uuid primary key default gen_random_uuid(),
  sort_order int not null default 0,
  role text not null,              -- 'travel','stay','general','food', etc.
  role_label_en text not null,
  role_label_hi text not null,
  name_en text not null,
  name_hi text,
  phone text not null,             -- digits with country code, e.g. 919XXXXXXXXX
  whatsapp text,                   -- optional separate WhatsApp number
  languages text not null default 'Hindi / English',
  photo_url text,
  active boolean not null default true
);

create table if not exists public.events (
  id uuid primary key default gen_random_uuid(),
  sort_order int not null default 0,
  slug text unique not null,
  name_en text not null, name_hi text not null,
  starts_at timestamptz, ends_at timestamptz,
  venue_name_en text, venue_name_hi text,
  dress_code_en text, dress_code_hi text,
  description_en text, description_hi text,
  active boolean not null default true
);

-- ============ ROW LEVEL SECURITY ============
alter table public.rsvps enable row level security;
alter table public.wishes enable row level security;
alter table public.song_requests enable row level security;
alter table public.contacts enable row level security;
alter table public.events enable row level security;

-- Guests (anon) can ONLY insert RSVPs. They cannot read anyone's data.
create policy "anon can insert rsvps" on public.rsvps
  for insert to anon with check (true);

-- Wishes: anyone can add (unapproved), anyone can read only approved ones.
create policy "anon can insert wishes" on public.wishes
  for insert to anon with check (approved = false);
create policy "anon can read approved wishes" on public.wishes
  for select to anon using (approved = true);

-- Song requests: insert only.
create policy "anon can insert songs" on public.song_requests
  for insert to anon with check (true);

-- Contacts and events: public read-only (active rows).
create policy "anon can read contacts" on public.contacts
  for select to anon using (active = true);
create policy "anon can read events" on public.events
  for select to anon using (active = true);

-- No update/delete policies for anon = they are impossible from the client.
-- You (the owner) manage all rows from the Supabase dashboard.

-- ============ STORAGE ============
-- In Dashboard -> Storage create a PUBLIC bucket named "invites"
-- (for invitation card PNG/PDF) and a PUBLIC bucket "photos" (couple photos,
-- contact photos). Upload files there; use their public URLs in the site.
```

> Security notes: the anon key is public by design, and RLS is what protects the data. Never put the `service_role` key in AI Studio or in client code. Because RSVP rows hold phone numbers, no `select` policy exists for anon, so only you can read them in the dashboard.

